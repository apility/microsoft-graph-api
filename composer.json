{
   "name": "apility/microsoft-graph-api",
   "description": "This package provides a PHP client library for working with the Microsoft Graph API.",
   "keywords": [
      "microsoft",
      "graph",
      "api",
      "laravel",
      "package"
   ],
   "license": "MIT",
   "authors": [
      {
         "name": "Thomas Alrek",
         "email": "thomas@apility.no"
      }
   ],
   "type": "library",
   "require": {
      "php": "^8.0.2",
      "illuminate/cache": "^9.0|^10.0|^11.0|^12.0|^13.0",
      "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
      "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
      "illuminate/routing": "^9.0|^10.0|^11.0|^12.0|^13.0",
      "laravel/socialite": "^5.8",
      "socialiteproviders/microsoft-azure": "^5.1",
      "league/flysystem": "^3.0"
   },
   "require-dev": {
      "illuminate/config": "^9.0|^10.0|^11.0|^12.0|^13.0",
      "illuminate/container": "^9.0|^10.0|^11.0|^12.0|^13.0",
      "larapack/dd": "^1.1",
      "phpunit/phpunit": "^9.6|^10.0|^11.0|^12.0"
   },
   "autoload": {
      "psr-4": {
         "Microsoft\\GraphAPI\\": "src/"
      }
   },
   "extra": {
      "laravel": {
         "providers": [
            "Microsoft\\GraphAPI\\ServiceProvider"
         ]
      }
   }
}
